<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp">

    <!-- Incoming message (Bot / Operator) -->
    <LinearLayout
        android:id="@+id/layout_incoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bg_card_secondary_rounded"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Бот-помощник"
            android:textColor="@color/mint"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_incoming_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Здравствуйте! Чем я могу вам помочь?"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Outgoing message (User) -->
    <LinearLayout
        android:id="@+id/layout_outgoing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="64dp"
        android:background="@drawable/bg_button_purple"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_outgoing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Здравствуйте, перевёл деньги другу"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
