<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ropay_logo"
        android:contentDescription="RoPay Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="RoPay Bank"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_pin_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Введите PIN-код для входа"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <!-- 4 PIN Dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_circle_avatar" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_circle_avatar" />

        <View
            android:id="@+id/dot_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_circle_avatar" />

        <View
            android:id="@+id/dot_4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_circle_avatar" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Numpad Grid -->
    <GridLayout
        android:id="@+id/grid_numpad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginBottom="24dp">

        <!-- 1 to 9 -->
        <TextView android:id="@+id/btn_key_1" style="@style/PinKey" android:text="1" />
        <TextView android:id="@+id/btn_key_2" style="@style/PinKey" android:text="2" />
        <TextView android:id="@+id/btn_key_3" style="@style/PinKey" android:text="3" />

        <TextView android:id="@+id/btn_key_4" style="@style/PinKey" android:text="4" />
        <TextView android:id="@+id/btn_key_5" style="@style/PinKey" android:text="5" />
        <TextView android:id="@+id/btn_key_6" style="@style/PinKey" android:text="6" />

        <TextView android:id="@+id/btn_key_7" style="@style/PinKey" android:text="7" />
        <TextView android:id="@+id/btn_key_8" style="@style/PinKey" android:text="8" />
        <TextView android:id="@+id/btn_key_9" style="@style/PinKey" android:text="9" />

        <!-- Biometrics, 0, Backspace -->
        <ImageView
            android:id="@+id/btn_key_bio"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_circle_avatar"
            android:padding="22dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/mint"
            android:contentDescription="Biometrics" />

        <TextView android:id="@+id/btn_key_0" style="@style/PinKey" android:text="0" />

        <ImageView
            android:id="@+id/btn_key_backspace"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_circle_avatar"
            android:padding="22dp"
            android:src="@drawable/ic_close"
            app:tint="@color/white"
            android:contentDescription="Backspace" />
    </GridLayout>

    <TextView
        android:id="@+id/btn_pin_logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Войти по номеру телефона"
        android:textColor="@color/mint"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
