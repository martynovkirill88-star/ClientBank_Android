<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Заявка на открытие"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_close_reg"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_keypad_button"
                    android:contentDescription="Close"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <!-- Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_status_pill"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ОТКРЫТИЕ СЧЁТА"
                    android:textColor="@color/mint"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Регистрация доступна на нашем веб-сайте ropay.site. Оставьте заявку, чтобы открыть счет в банке RoPay:"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- First Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ИМЯ В ПРИЛОЖЕНИИ"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_reg_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="Кирилл"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <!-- Last Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ФАМИЛИЯ В ПРИЛОЖЕНИИ"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_reg_surname"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="Мартынов"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <!-- Phone Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="НОМЕР ТЕЛЕФОНА"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_reg_phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="+7 999 123-45-67"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:text="+7"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Этот номер телефона будет использован для переводов"
                android:textColor="@color/mint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- PIN Code 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ПРИДУМАЙТЕ ПИН-КОД (4 ЦИФРЫ)"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_reg_pin1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="••••"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <!-- PIN Code 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ПОВТОРИТЕ ПИН-КОД"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_reg_pin2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="••••"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <!-- Telegram Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ЮЗЕРНЕЙМ В TELEGRAM"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_reg_telegram"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="@username"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Чтобы мы могли связаться с вами после рассмотрения заявки"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <!-- Error Message -->
            <TextView
                android:id="@+id/tv_reg_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Submit Button -->
            <LinearLayout
                android:id="@+id/btn_reg_submit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_mint"
                android:gravity="center"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/pb_reg_loading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminateTint="@color/bg_dark"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_reg_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_telegram"
                    app:tint="@color/bg_dark" />

                <TextView
                    android:id="@+id/tv_reg_btn_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Оставить заявку"
                    android:textColor="@color/bg_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
